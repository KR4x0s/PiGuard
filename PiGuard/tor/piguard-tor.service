[Unit]
Description=PiGuard optional Tor gateway transport
Requires=piguard-gateway-guard.service
Wants=network-online.target
After=network-online.target piguard-gateway-guard.service

[Service]
Type=simple
User=piguard-tor
Group=piguard-tor
StateDirectory=piguard-tor
StateDirectoryMode=0700
ExecStartPre=/usr/bin/tor --verify-config -f /etc/piguard-tor/torrc
ExecStart=/usr/bin/tor -f /etc/piguard-tor/torrc
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/piguard-tor
MemoryMax=192M
CPUQuota=50%

